---
interface Props {
  href?: string;
  label?: string;
}

const { href = "/", label = "Back" } = Astro.props;
---

<a
  href={href}
  class="back-button"
  aria-label={label}
>
  <svg
    class="back-button__icon"
    width="20"
    height="20"
    viewBox="0 0 20 20"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      d="M12.5 15L7.5 10L12.5 5"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  <span class="back-button__text">{label}</span>
</a>

<style>
  .back-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    min-height: 44px;
    border-radius: 8px;
    /* Light mode: dark teal for contrast on light bg */
    color: var(--color-brand-green-300, #1f3641);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 200ms cubic-bezier(0.23, 1, 0.32, 1),
      color 200ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 150ms cubic-bezier(0.23, 1, 0.32, 1);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .back-button__icon {
    flex-shrink: 0;
    transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .back-button__text {
    line-height: 1;
  }

  /* Hover only on devices that support it */
  @media (hover: hover) and (pointer: fine) {
    /* Light mode hover: subtle dark bg */
    .back-button:hover {
      background-color: rgba(31, 54, 65, 0.08);
      color: var(--color-brand-green-400, #1a2a33);
    }

    .back-button:hover .back-button__icon {
      transform: translateX(-2px);
    }
  }

  /* Press feel */
  .back-button:active {
    transform: scale(0.97);
  }

  /* Focus visible for keyboard navigation */
  .back-button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  /* Dark mode */
  :global(.dark) .back-button {
    color: var(--color-brand-green-100, #65e9e4);
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.dark) .back-button:hover {
      background-color: rgba(101, 233, 228, 0.1);
      color: var(--color-brand-green-100, #65e9e4);
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .back-button,
    .back-button__icon {
      transition-duration: 0s;
    }

    .back-button:hover .back-button__icon {
      transform: none;
    }
  }

  /* No hardware acceleration fallback */
  :global(.no-hw-accel) .back-button,
  :global(.no-hw-accel) .back-button__icon {
    transition-duration: 0s;
  }

  :global(.no-hw-accel) .back-button:hover .back-button__icon {
    transform: none;
  }
</style>
