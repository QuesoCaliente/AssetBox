---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"article"> {
  title: string;
  href?: string;
}
const { title, class: estilos, href, ...rest } = Astro.props;
---

<a href={href} class="card-3d">
  <article class={estilos} {...rest}>
    <div class="icon-3d">
      <slot name="icon" />
    </div>
    <h1 class="text-xl text-balance">{title}</h1>
  </article>
</a>
